# This boilerplate ships the agent/spec system only. The React Native sections below
# are pre-seeded so that an app created inside this repo is covered from the first
# commit. If the RN CLI overwrites this file during init, re-add the two blocks marked
# BOILERPLATE — losing them means committing secrets or generated agent skills.

# node.js
#
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log*

# Logs
#
*.log
logs/

# BOILERPLATE: Secrets and environment
#
# docs/standards.md → Security: secrets, API keys and credentials MUST NOT be
# committed. Commit .env.example with empty values instead.
.env
.env.*
!.env.example

# BOILERPLATE: Agent skills synced from SDK packages
#
# Generated by scripts/sync-sdk-skills.mjs on postinstall. Never commit: the source
# of truth is each package's own skills/ folder, versioned with that package.
.claude/skills/sdk-*/
.claude/skills/sdk-manifest.json

# TypeScript
#
*.tsbuildinfo

# testing
/coverage

# OSX
#
.DS_Store

# Windows
#
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local

# Android/IntelliJ
#
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# Android signing
#
*.jks
keystore.properties
android/keystore.properties
android/app/keystore.properties

# Ruby / CocoaPods
#
**/Pods/
/vendor/bundle/

# Metro
#
.metro-health-check*

# Bundle artifact
*.jsbundle

# fastlane
#
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Local Android build artifacts
.artifacts/

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

<?xml version="1.0" encoding="utf-8"?>
<!--
  Same layers as ic_launcher. An adaptive icon is already mask-agnostic — the
  launcher decides whether it ends up round — so the round variant differs only
  in which manifest attribute points at it (android:roundIcon).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

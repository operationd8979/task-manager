<?xml version="1.0" encoding="utf-8"?>
<!--
  Read from Android 12 (API 31) upward.

  FR-049 requires that task data is never restored automatically after a
  reinstall. `android:allowBackup="false"` already switches off cloud backup,
  but device-to-device transfer is governed separately and stays enabled unless
  it is excluded here.
-->
<data-extraction-rules>
  <!--
    The notification SDK's state record is excluded from both paths for a
    different reason than task data: its deduplication ledger, restored onto
    another device, claims payloads were already delivered and silently
    suppresses real ones.
  -->
  <cloud-backup>
    <exclude domain="file" path="chipmobilesdk-localdb/" />
    <exclude domain="file" path="mmkv/chipmobilesdk.notification" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="chipmobilesdk-localdb/" />
    <exclude domain="file" path="mmkv/chipmobilesdk.notification" />
  </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Read below Android 12 (API 31). Kept alongside data_extraction_rules.xml
  because minSdkVersion is 24 and both paths are live.
-->
<full-backup-content>
  <exclude domain="file" path="chipmobilesdk-localdb/" />
  <!--
    The notification SDK's state record. A deduplication ledger restored onto
    another device claims payloads were already delivered, which silently
    suppresses real ones.
  -->
  <exclude domain="file" path="mmkv/chipmobilesdk.notification" />
</full-backup-content>

<!--
  Adaptive icon foreground: a timeline spine with three sessions on it.

  Drawn on the mandated 108x108 canvas. Every launcher masks this to a shape it
  chooses, and only the centre 66x66 is guaranteed to survive that mask — so
  the mark sits inside roughly 33..76 on both axes with room to spare. Anything
  drawn nearer the edge is a gamble on which launcher the user has.

  Geometry is kept in sync with scripts/generate-android-icons.mjs, which draws
  the same mark into the legacy PNGs for Android 7 (minSdk 24 predates adaptive
  icons, so both forms have to exist and have to match).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Spine -->
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M36,30 h6 v48 h-6 z" />

    <!-- Session markers, sitting on the spine -->
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M39,32 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M39,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M39,76 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />

    <!-- The work itself: shorter each time, so the mark reads as a schedule
         rather than as a list -->
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M53,29 h24 v6 h-24 z" />
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M53,51 h19 v6 h-19 z" />
    <path
        android:fillColor="#F3F2F2"
        android:pathData="M53,73 h14 v6 h-14 z" />

</vector>
